# Copy to .env and fill in your key.
# --- Claude (Anthropic API) — primary model for all agents ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# true = run with canned sample data (no key needed); false = use the real API.
USE_MOCK_CLAUDE=true

# --- Ollama (local-dev fallback only) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
